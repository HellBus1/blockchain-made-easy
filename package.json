{
  "name": "blockchain-made-easy",
  "description": "project to learn blockchain from scratch",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/cf-postbuild.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx,astro,css,md,mdx}'",
    "test": "vitest run",
    "prepare": "husky install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@astrojs/starlight": "^0.42.7",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@noble/curves": "^2.1.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@types/node": "^22.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,astro,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
